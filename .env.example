# ローカル実PDF評価専用。実際の値はGit管理外の.envに保存してください。
TDNET_DIGEST_PROVIDER=openai
TDNET_DIGEST_API_KEY=
TDNET_DIGEST_MODEL=gpt-4o-mini
# customプロバイダーの場合のみ指定
TDNET_DIGEST_BASE_URL=

# evaluation/fixtures/real-pdf-cases.json にあるIDを1件指定
TDNET_EVAL_CASE_ID=140120260709590576
# check-real-pdfs.mjsが生成したページ境界付きテキストの親ディレクトリ
TDNET_EVAL_PDF_DIR=/tmp/tdnet-real-eval
